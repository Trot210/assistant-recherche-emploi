# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (utilisé aux étapes scoring / génération de documents)
ANTHROPIC_API_KEY=

# France Travail (OAuth2 client_credentials)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# APEC
APEC_API_KEY=

# Sync automatique (GitHub Actions → /api/offres/sync, sans session utilisateur)
CRON_SECRET=
SYNC_USER_ID=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envoi des candidatures depuis la plateforme (SMTP) — le plus simple avec Gmail :
# 1. Active la validation en deux étapes sur ton compte Google
#    (myaccount.google.com → Sécurité)
# 2. myaccount.google.com/apppasswords → crée un mot de passe d'application
#    (16 caractères) — ce n'est PAS ton mot de passe habituel
# 3. SMTP_USER = ton adresse Gmail, SMTP_PASSWORD = ce mot de passe d'application
# Les messages partent de ton adresse, apparaissent dans « Envoyés » et les
# réponses arrivent dans ta boîte. Autre messagerie : ajoute SMTP_HOST et SMTP_PORT.
SMTP_USER=
SMTP_PASSWORD=
