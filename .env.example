# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (utilisé aux étapes scoring / génération de documents)
ANTHROPIC_API_KEY=

# France Travail (OAuth2 client_credentials)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# APEC
APEC_API_KEY=

# Sync automatique (GitHub Actions → /api/offres/sync, sans session utilisateur)
CRON_SECRET=
SYNC_USER_ID=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail — brouillons de candidatures spontanées (portée gmail.compose uniquement :
# l'appli crée des brouillons, elle n'envoie rien et ne lit pas ta boîte).
# 1. console.cloud.google.com → nouveau projet → activer « Gmail API »
# 2. Écran de consentement OAuth : type « Externe », ajoute ton adresse en
#    utilisateur test, puis passe la publication en « Production » (sinon le
#    refresh token expire au bout de 7 jours)
# 3. Identifiants → ID client OAuth (type « Application Web »), URI de redirection
#    https://developers.google.com/oauthplayground
# 4. OAuth Playground (roue crantée → « Use your own OAuth credentials ») →
#    portée https://www.googleapis.com/auth/gmail.compose → échanger le code
#    contre un refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Hunter.io (facultatif) — recherche de contacts nominatifs par domaine.
# L'offre gratuite donne un petit quota mensuel ; clé sur hunter.io → API.
HUNTER_API_KEY=
